# URL base de la API backend
VITE_API_BASE_URL=http://localhost:4000

# API Key para el header x-api-key (debe coincidir con la del backend).
# NOTA: en una SPA la key queda expuesta en el navegador; en producción se
# recomienda usar un backend-for-frontend/proxy. Para la prueba técnica se
# incluye aquí por simplicidad.
VITE_API_KEY=cargo-express-demo-key-2026
