# ==================================================================
# Variables para docker-compose (orquestación de todo el proyecto)
# Copia este archivo a .env y ajusta los valores si es necesario:
#   cp .env.example .env
# ==================================================================

# Clave de la API (debe coincidir en backend y frontend)
API_KEY=cargo-express-demo-key-2026

# Puertos publicados en el host
BACKEND_PORT=4000
FRONTEND_PORT=8080

# Origen permitido por CORS en el backend (URL del frontend)
CORS_ORIGIN=http://localhost:8080

# URL del backend que consumirá el navegador (build del frontend)
VITE_API_BASE_URL=http://localhost:4000

# ------------------------------------------------------------------
# Base de datos MySQL
# ------------------------------------------------------------------
DB_NAME=recolecciones
DB_USER=recolecciones
DB_PASSWORD=recolecciones123
DB_ROOT_PASSWORD=rootpass
DB_PORT=3306
