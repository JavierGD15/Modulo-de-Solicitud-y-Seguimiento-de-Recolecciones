# ------------------------------------------------------------------
# Configuración del servidor
# ------------------------------------------------------------------
# Puerto donde escucha la API
PORT=4000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# ------------------------------------------------------------------
# Seguridad
# ------------------------------------------------------------------
# Clave que el cliente debe enviar en el header "x-api-key".
# En producción usar un valor largo y aleatorio.
API_KEY=cargo-express-demo-key-2026

# ------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------
# Origen permitido para el frontend (usar * solo en desarrollo).
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------
# Base de datos MySQL
# ------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=recolecciones
DB_PASSWORD=recolecciones123
DB_NAME=recolecciones
